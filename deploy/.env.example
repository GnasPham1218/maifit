# =============================================================================
# MAIFit - production environment template
# =============================================================================
# How to use (on the VPS, inside the deploy/ folder):
#   1. cp .env.example .env
#   2. Fill in every empty value below
#   3. chmod 600 .env        # only your user can read it
#
# Never commit the real .env file. Only this template belongs in git.
# Keep comments on their own lines: inline comments may be read as part of a value.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Database name and user created on first start of the Postgres container.
POSTGRES_DB=maifit
POSTGRES_USER=maifit

# Required. Use a long random value, different from your local dev password.
# Generate one with:  openssl rand -hex 32
# Postgres refuses to start if this is empty.
POSTGRES_PASSWORD=

# --- Container images (GitHub Container Registry) ----------------------------
# Required. GitHub username or organization that owns the images, in lowercase.
# Example: for ghcr.io/octocat/maifit-backend, use: octocat
GHCR_OWNER=

# Image tag to run. CI/CD overwrites this with the commit SHA on each deploy.
# Use "latest" only for a manual first deploy.
IMAGE_TAG=latest

# --- Auth -------------------------------------------------------------------
# Required. Key that signs the JWT access tokens: at least 32 random bytes, Base64.
# Use a DIFFERENT value from your local dev key. Generate one with:  openssl rand -base64 32
JWT_SECRET=

# Required. Public URL of the site, used to build the links in emails.
FRONTEND_URL=https://maifit.gnaspham1218.dev

# --- Email (Gmail SMTP) -----------------------------------------------------
# Required. A Gmail account used only by MAIFit, and a Gmail App Password for it
# (Google Account > Security > 2-Step Verification > App passwords). No spaces.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- CAPTCHA (Cloudflare Turnstile) ------------------------------------------
# Required. Secret key of the "maifit" widget (Cloudflare dashboard > Turnstile).
# Never the test key 1x0000000000000000000000000000000AA here: it lets every request through.
# The public SITE key is not set here: it is the GitHub repository variable VITE_TURNSTILE_SITE_KEY.
TURNSTILE_SECRET_KEY=

# --- Payments (payOS) -------------------------------------------------------------
# Required. Keys of the payment channel (my.payos.vn > Kenh thanh toan > the channel's details).
# After the first deploy with these keys, register the webhook URL once in the same screen:
#   https://<your-domain>/api/payments/webhook/payos
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
# Optional. Price of Premium in VND (default 29999).
# PREMIUM_PRICE=29999
