POSTGRES_DB=maifit
POSTGRES_USER=maifit
POSTGRES_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/maifit
JWT_SECRET=change-me-base64-32-bytes
MAIL_USERNAME=your-app-account@gmail.com
MAIL_PASSWORD=gmail-app-password
GEMINI_API_KEY=<your-GEMINI_API_KEY>
# Cloudflare Turnstile TEST secret (public, always passes). Production uses the real key in deploy/.env.
# Use 2x0000000000000000000000000000000AA instead to test the "CAPTCHA failed" path.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# payOS payment channel keys (my.payos.vn > Kenh thanh toan). Real keys: payOS has no sandbox.
PAYOS_CLIENT_ID=<your-PAYOS_CLIENT_ID>
PAYOS_API_KEY=<your-PAYOS_API_KEY>
PAYOS_CHECKSUM_KEY=<your-PAYOS_CHECKSUM_KEY>
# Local only: a small Premium price so each test transfer costs little (default 29999)
PREMIUM_PRICE=2000
# Optional: only set when Google retires the default model in application.yaml
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: chat only (photo recognition keeps GEMINI_MODEL)
# GEMINI_CHAT_MODEL=gemini-3.1-flash-lite
